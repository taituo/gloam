# Gloam Pico for Ghostty
# 1. Install fonts/GloamPico-Regular.ttf
# 2. Add these lines to your Ghostty config

font-family = "Gloam Pico"

# Cell = 4 x 8 font pixels. The em must be
# a multiple of 8 device pixels:
#   macOS Retina: 12 -> 3x, 16 -> 4x, 24 -> 6x
#   Linux 96 dpi: 12 -> 2x, 18 -> 3x, 24 -> 4x
font-size = 12

# No synthetic bold/italic: they smear pixels.
font-synthetic-style = false
# Bold as bright colours (Ghostty 1.2+;
# older: bold-is-bright = true)
bold-color = bright

# Linux: hard 1-bit pixel edges
freetype-load-flags = no-hinting,monochrome

# macOS: keep strokes one pixel wide
font-thicken = false

# Optional line spacing. 25% = 2 font px,
# split evenly, so pixels stay whole:
# adjust-cell-height = 25%
